[Unit]
Description=Jarvis lokal agent og backend
Documentation=file:///opt/jarvis-agent/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis-agent
EnvironmentFile=/etc/jarvis/agent.env
ExecStart=/usr/bin/node /opt/jarvis-agent/server.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-agent

# Begrenset sudo brukes bare til eksplisitt hvitelistede vedlikeholdsskript.
# NoNewPrivileges må derfor være av; ellers blokkerer Linux sudo før sudoers
# rekker å godkjenne INSTALLER PIPER / GUI-oppdatering.
NoNewPrivileges=false
ProtectSystem=full
ProtectKernelTunables=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/jarvis /var/log/jarvis /etc/jarvis /opt/jarvis
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
