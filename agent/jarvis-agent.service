[Unit]
Description=Jarvis lokal agent og backend
Documentation=file:///opt/jarvis-agent/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis-agent
EnvironmentFile=/etc/jarvis/agent.env
ExecStart=/usr/bin/node /opt/jarvis-agent/server.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jarvis-agent

# Herding – moderat, slik at systemd alltid får satt opp tjenesten på Jetson
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/jarvis /var/log/jarvis
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
