# Miljøvariabler for jarvis-agent (kopier til /etc/jarvis/agent.env, chmod 600)

# Nettverk
AGENT_HOST=0.0.0.0
AGENT_PORT=8787

# Token for OS/sandkasse-endepunktene (backend-API-et bruker egen innlogging)
AGENT_TOKEN=bytt-meg-til-noe-langt-og-tilfeldig

# Data og sandkasse
AGENT_DATA=/var/lib/jarvis/data
AGENT_SANDBOX=/var/lib/jarvis/sandbox

# HTTPS/TLS – fyll inn når sertifikatene finnes
#AGENT_TLS_CERT=/var/lib/jarvis/certs/agent.crt
#AGENT_TLS_KEY=/var/lib/jarvis/certs/agent.key
#AGENT_TLS_CA=/var/lib/jarvis/certs/ca.crt

# Grenser for skriptkjøring
AGENT_MAX_TIMEOUT=60000
AGENT_MAX_OUTPUT=200000
AGENT_ALLOW_NETWORK=1
