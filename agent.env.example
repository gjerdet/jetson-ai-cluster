
# --- Bak reverse proxy (Caddy/Nginx) --------------------------------------
# Sett til 1 KUN når agenten står bak en proxy du selv styrer. Da leses
# klientens IP fra x-forwarded-for slik at rate-limiting virker per bruker.
AGENT_TRUST_PROXY=0

# Valgfri HTTP-lytter som sender alt videre til HTTPS (krever TLS i agenten).
# AGENT_HTTP_REDIRECT_PORT=8786
